// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  sessions     Session[]
  lists        List[]
  purchases    Purchase[]
}

model Session {
  id        String   @id // random token stored in the httpOnly cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model List {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Item[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model Item {
  id         String    @id @default(cuid())
  name       String
  quantity   Int       @default(1)
  listId     String
  list       List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  checkedAt  DateTime? // null = still to buy
  priceCents Int? // unit price in euro cents; null = not entered
  createdAt  DateTime  @default(now())
  purchase   Purchase?

  @@index([listId])
}

// One row per checked-off item: the source of truth for spend, habits and suggestions.
// Survives deletion of its item or list (itemId becomes null). Written only by syncPurchase.
model Purchase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String?  @unique // the checked item this records; null once the item is deleted
  item        Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name        String // productKey(): lowercased + trimmed, so "Milk " == "milk"
  displayName String   @default("") // name as last typed, for display; grouping uses `name`
  quantity    Int      @default(1)
  priceCents  Int? // unit price in euro cents; null = not entered
  listName    String? // snapshot at purchase time, kept after the list is deleted
  purchasedAt DateTime @default(now())

  @@index([userId, name, purchasedAt])
  @@index([userId, purchasedAt])
}
