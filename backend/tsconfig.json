{
  "compilerOptions": {
    // File layout: compile src/ into dist/ (matches the "start" script)
    "rootDir": "src",
    "outDir": "dist",

    // Environment
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    // Outputs
    "sourceMap": true,

    // Type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Module handling
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}
